# Copy this file to .env for local development (.env is gitignored, never commit real values).

POSTGRES_USER=noxoj
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=noxoj

# App config — these have working defaults, only set them to override.
# ENVIRONMENT must be one of: development, test, production
ENVIRONMENT=development
PORT=8081

# Where the app looks for Postgres. "localhost" is correct when running
# `go run ./cmd/api` directly against docker-compose's published port.
# Inside docker-compose itself, the api service overrides this to
# "postgres" (the Compose service name) — you don't need to set that
# part yourself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
